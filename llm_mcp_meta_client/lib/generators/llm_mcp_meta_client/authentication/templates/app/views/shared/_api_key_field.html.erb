<%
  llm_options = locals[:llm_options]
  stimulus_controller = locals[:stimulus_controller]
%>
<div class="api-key-field">
  <label>LLM Service</label>
  <%%= select_tag :api_key_uuid,
                 options_for_select([["Please select a service", ""]] +
                                    (llm_options || []).map { |opt| [opt[:description], opt[:uuid]] }),
                 { required: true,
                   data: {
                     "#{stimulus_controller.gsub('-', '_')}_target": "apiKey",
                     action: "change->"#{stimulus_controller.gsub('-', '_')}_target"#apiKeyChanged change->"#{stimulus_controller.gsub('-', '_')}_target"#updateSubmitButton",
                     models: (llm_options || []).map { |opt| { value: opt[:uuid], models: opt[:available_models], type: opt[:type] } }.to_json
                   } } %>
</div>
