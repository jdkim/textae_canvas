<%
  ann = locals[:ann]
  next_ann = locals[:next_ann]
  active_uuid = locals[:active_uuid]
%>

<% if ann.present? %>
  <% parent_uuid = ann.parent&.uuid %>

  <div class="history-card <%= 'is-active' if ann.uuid == active_uuid %>" data-uuid="<%= ann.uuid %>" data-parent-uuid="<%= parent_uuid %>">
    <%= link_to edit_ai_annotation_path(ann.uuid), class: "history-card-link" do %>
      <div class="history-card-prompt"><%= truncate(ann.prompt.to_s, length: 50) %></div>
    <% end %>
  </div>

  <% if !next_ann.nil? && parent_uuid == next_ann.uuid %>
    <div class="history-straight-arrow">↑</div>
  <% end %>
<% end %>
