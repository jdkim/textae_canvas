<%
  ann = locals[:ann]
  next_ann = locals[:next_ann]
  is_active = locals[:is_active]
  parent_uuid = ann.parent&.uuid
%>

<div class="history-card<%= ' is-active' if is_active %>" data-uuid="<%= ann.uuid %>" data-parent-uuid="<%= parent_uuid %>">
  <%= link_to edit_ai_annotation_path(ann.uuid), class: "history-card-link" do %>
    <div class="history-card-prompt"><%= truncate(ann.prompt.to_s, length: 50) %></div>
  <% end %>
</div>

<%# Check !next_ann.nil? to prevent the "↑" arrow from appearing below the bottom history entry, as parent_uuid would be nil in that case. %>
<% if !next_ann.nil? && parent_uuid == next_ann.uuid %>
  <div class="history-straight-arrow">↑</div>
<% end %>