<div class="textae-container" data-controller="textae-container">
  <div id="ai-textae-editor" mode="view" control="visible" inspect="current-annotation" data-textae-container-target="editor">
    <%= @ai_annotation.content %>
  </div>
  <div id="current-annotation"></div>
</div>

<%= form_with model: @ai_annotation, url: ai_annotation_path(@ai_annotation.uuid), class: "ai-annotation-form", data: { controller: "ai-annotation-form", action: "input->ai-annotation-form#updateSubmitButton" } do |f| %>
  <div class="prompt-field">
    <label>Prompt</label>
    <%= f.textarea :prompt, required: true, rows: 3, placeholder: "Order how to annotate the text", data: { ai_annotation_form_target: "prompt" } %>
  </div>

  <%= f.hidden_field :content, id: 'textae-annotation' %>

  <div class="submit-row">
    <div class="api-key-field">
      <label>API Key</label>
      <%= select_tag :api_key_uuid,
          options_for_select([["Please select an API key", ""]] +
            (@llm_api_keys || []).map { |key| [key['description'], key['uuid'], { 'data-models' => key['available_models'].to_json }] }),
          { required: true,
            data: { action: "change->ai-annotation-form#apiKeyChanged change->ai-annotation-form#updateSubmitButton" } } %>
    </div>

    <div class="model-field">
      <label>LLM model</label>
      <%= select_tag :model, options_for_select([["Please select API key first", ""]]),
          { required: true, disabled: true,
            data: { ai_annotation_form_target: "model", action: "change->ai-annotation-form#updateSubmitButton" } } %>
    </div>

    <div class="submit-field">
      <%= f.submit "Annotate", disabled: true, class: "button", data: { ai_annotation_form_target: "submit" } %>
    </div>
  </div>
<% end %>
