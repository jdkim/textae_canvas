<%= form_with model: @new_ai_annotation, class: "ai-annotation-form", data: { controller: "ai-annotation-form", action: "input->ai-annotation-form#updateSubmitButton" } do |f| %>
  <div class="text-field">
    <label>Text</label>
    <%= f.textarea :text, required: true, rows: 15, placeholder: "Write or paste text here", data: { ai_annotation_form_target: "text" } %>
  </div>

  <div class="prompt-field">
    <label>Prompt</label>
    <%= f.textarea :prompt, required: true, rows: 3, placeholder: "Order how to annotate the text", data: { ai_annotation_form_target: "prompt" } %>
  </div>

  <div class="submit-row">
    <%= render 'api_key_field' %>
    <%= render 'model_field' %>

    <div class="submit-field">
      <%= f.submit "Annotate", disabled: true, class: "button", data: { ai_annotation_form_target: "submit" } %>
    </div>
  </div>
<% end %>
