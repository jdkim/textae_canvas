<div class="api-key-field">
  <label>LLM Service</label>
  <%= select_tag :api_key_uuid,
                 options_for_select([["Please select a service", ""]] +
                                    (@llm_options || []).map { |opt| [opt[:description], opt[:uuid]] }),
                 { required: true,
                   data: {
                     ai_annotation_form_target: "apiKey",
                     action: "change->ai-annotation-form#apiKeyChanged change->ai-annotation-form#updateSubmitButton",
                     models: (@llm_options || []).map { |opt| { value: opt[:uuid], models: opt[:available_models], type: opt[:type] } }.to_json
                   } } %>
</div>
